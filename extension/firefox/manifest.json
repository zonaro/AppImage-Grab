{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.0.1",
  "version_name": "Build template",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging",
    "alarms",
    "notifications",
    "tabs"
  ],
  "action": {
    "default_title": "Gear Lever Grab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "build-revision.js",
      "i18n.js",
      "native-client.js",
      "update-check.js",
      "notifications.js",
      "page-offers.js",
      "page-offer-background.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gear-lever-grab@redclaw.com.br",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://appimage.github.io/*",
    "https://api.opendesktop.org/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  }
}
